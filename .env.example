# Copy to .env and fill in. Never commit the real .env.

# ID from the sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Staff Duty Rotation

# Google auth (OAuth as your own account — works for domain-restricted sheets
# you can already open, e.g. a berkeley.edu sheet you can't share with a bot
# email). Download an OAuth client (Desktop app) JSON and point to it here. The
# first run opens a browser to log in and caches a token at GOOGLE_OAUTH_TOKEN_JSON.
GOOGLE_OAUTH_CLIENT_JSON=secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_JSON=secrets/authorized_user.json

TIMEZONE=America/Los_Angeles

# Year to assume for sheet dates like "July 5" that omit the year
DUTY_YEAR=2026

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=

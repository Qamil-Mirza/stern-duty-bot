# Copy to .env and fill in. Never commit the real .env.

# ID from the sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Staff Duty Rotation

# Service account key file (relative path works both locally and in Docker)
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json

TIMEZONE=America/Los_Angeles

# Year to assume for sheet dates like "July 5" that omit the year
DUTY_YEAR=2026

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
